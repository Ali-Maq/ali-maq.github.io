---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    {% if page.cv_pdf %}
      <a
        class="btn btn-sm z-depth-0 cv-download"
        href="{{ page.cv_pdf | prepend: '/assets/pdf/' | relative_url }}{% if page.cv_pdf_revision %}?v={{ page.cv_pdf_revision }}{% endif %}"
        target="_blank"
        rel="noopener noreferrer"
        ><i class="fa-solid fa-file-pdf" aria-hidden="true"></i> Download résumé (PDF)</a
      >
    {% endif %}
  </header>
  <article class="cv">
    {% for data in site.data.resume %}
      {% if data[1].size == 0 %}{% continue %}{% endif %}
      <section class="card mt-4 p-3 p-md-4" aria-labelledby="{{ data[0] }}">
        <h2 class="card-title font-weight-medium h3" id="{{ data[0] }}">
          {% case data[0] -%}
            {%- when 'basics' -%}
              Profile
            {%- when 'work' -%}
              Experience
            {%- when 'publications' -%}
              Research publications
            {%- when 'skills' -%}
              Technical Skills
            {%- when 'awards' -%}
              Independent engineering and recognition
            {%- else -%}
              {{- data[0] | capitalize -}}
          {%- endcase %}
        </h2>
        {% case data[0] %}
          {% when 'basics' -%}
            {%- include resume/basics.liquid %}
          {% when 'work' -%}
            {%- include resume/work.liquid %}
          {% when 'publications' %}
            <p><a href="https://scholar.google.com/citations?user=rAAtZi0AAAAJ">Full publication list on Google Scholar</a></p>
            {% include resume/publications.liquid %}
          {% when 'education' -%}
            {%- include resume/education.liquid %}
          {% when 'skills' -%}
            {%- include resume/skills.liquid %}
          {% when 'awards' -%}
            {%- include resume/awards.liquid %}
        {% endcase %}
      </section>
    {% endfor %}
  </article>
</div>

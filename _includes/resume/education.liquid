<ul class="list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item px-0 py-3">
      <h3 class="h5 font-weight-bold" data-toc-skip>{{ content.studyType }} in {{ content.area }}</h3>
      <p class="mb-1">
        {% if content.url -%}
          <a href="{{ content.url }}">{{ content.institution }}</a>
        {%- else -%}
          {{- content.institution -}}
        {%- endif %}
      </p>
      <p class="mb-0">{{ content.startDate | slice: 0, 4 }} – {{ content.endDate | slice: 0, 4 }}</p>
    </li>
  {% endfor %}
</ul>

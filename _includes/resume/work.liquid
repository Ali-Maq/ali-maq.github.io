<ul class="list-group list-group-flush">
  {% assign work = data[1] %}
  {% for content in work %}
    <li class="list-group-item px-0 py-3">
      <div class="row">
        <div class="col-12 col-md-3 cv-date-column mb-2">
          <span class="cv-date">
            {{- content.startDate | date: '%b %Y' }} – {% if content.endDate %}{{ content.endDate | date: '%b %Y' }}{% else %}Present{% endif -%}
          </span>
          {% if content.location %}
            <p class="small mt-1 mb-0">{{ content.location }}</p>
          {% endif %}
        </div>
        <div class="col-12 col-md-9">
          <h3 class="h5 font-weight-bold" data-toc-skip>
            {% if content.url -%}
              <a href="{{ content.url }}">{{ content.position }}</a>
            {%- else -%}
              {{- content.position -}}
            {%- endif %}
          </h3>
          <p class="font-weight-bold mb-2">{{ content.name }}</p>
          <p>{{ content.summary }}</p>
          {% if content.highlights.size > 0 %}
            <ul class="pl-3 mb-0">
              {% for item in content.highlights %}
                <li class="mb-2">{{ item }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>

<ul class="card-text list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item px-0">
      <h3 class="h5">
        <a href="{{ content.url | relative_url }}">{{ content.title }}</a>
      </h3>
      <p class="text-muted">{{ content.awarder }} · {{ content.date }}</p>
      <p>{{ content.summary }}</p>
    </li>
  {% endfor %}
</ul>

<p class="font-weight-bold mb-1">{{ data[1].name }} · {{ data[1].label }}</p>
<p>{{ data[1].summary }}</p>
<ul class="list-inline mb-0" aria-label="Professional profiles">
  {% for profile in data[1].profiles %}
    <li class="list-inline-item mr-3">
      <a href="{{ profile.url }}">{{ profile.network }}</a>
    </li>
  {% endfor %}
  <li class="list-inline-item"><a href="mailto:{{ data[1].email }}">Email</a></li>
</ul>

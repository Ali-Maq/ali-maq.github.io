<ul class="list-group list-group-flush">
  {% assign publications = data[1] | sort: 'releaseDate' | reverse %}
  {% for content in publications %}
    <li class="list-group-item px-0 py-3">
      <h3 class="h5 font-weight-bold" data-toc-skip>
        <a href="{{ content.url }}">{{ content.name }}</a>
      </h3>
      <p class="mb-2">{{ content.publisher }} · {{ content.releaseDate | slice: 0, 4 }}</p>
      <p>{{ content.summary }}</p>
      {% if content.scholar_url -%}
        <a href="{{ content.scholar_url }}" aria-label="Google Scholar record for {{ content.name | escape }}">Google Scholar record</a>
      {%- endif %}
    </li>
  {% endfor %}
</ul>

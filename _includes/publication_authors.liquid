{%- for author in include.authors -%}
  {%- unless forloop.first -%}
    {% if forloop.last %}, and {% else %}, {% endif %}
  {%- endunless -%}
  {%- assign author_is_self = false -%}
  {%- if site.scholar.last_name contains author.last and site.scholar.first_name contains author.first -%}
    {%- assign author_is_self = true -%}
  {%- endif -%}
  {%- assign coauthor_url = null -%}
  {%- assign author_key = author.last | downcase | remove_accents -%}
  {%- for coauthor in site.data.coauthors[author_key] -%}
    {%- if coauthor.firstname contains author.first -%}
      {%- assign coauthor_url = coauthor.url -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if author_is_self -%}
    <em>
      {{- author.first }}
      {{ author.last -}}
    </em>
  {%- elsif coauthor_url -%}
    <a href="{{ coauthor_url }}">
      {{- author.first }}
      {{ author.last -}}
    </a>
  {%- else -%}
    {{ author.first }}
    {{ author.last }}
  {%- endif -%}
{%- endfor -%}
